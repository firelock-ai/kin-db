{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SharedAdmissionPolicy",
  "description": "Replicated admission policy resolved at a semantic change.",
  "type": "object",
  "required": [
    "generation",
    "hash",
    "semantics_version",
    "sensitive_allowances",
    "sources"
  ],
  "properties": {
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "hash": {
      "$ref": "#/definitions/AdmissionPolicyHash"
    },
    "semantics_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "sensitive_allowances": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SensitiveArtifactAllowance"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AdmissionRuleSource"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AdmissionPolicyHash": {
      "description": "Content identity of a resolved shared admission policy.",
      "allOf": [
        {
          "$ref": "#/definitions/Hash256"
        }
      ]
    },
    "AdmissionRuleSource": {
      "description": "One branch-versioned gitwildmatch source.",
      "type": "object",
      "required": [
        "body_hash",
        "body_len",
        "kind",
        "path",
        "precedence"
      ],
      "properties": {
        "base_directory": {
          "description": "Directory against which patterns in this source are rooted. `None` denotes the repository root.",
          "anyOf": [
            {
              "$ref": "#/definitions/RepoPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_hash": {
          "$ref": "#/definitions/Hash256"
        },
        "body_len": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "$ref": "#/definitions/AdmissionRuleSourceKind"
        },
        "path": {
          "$ref": "#/definitions/RepoPath"
        },
        "precedence": {
          "description": "Low-to-high precedence. Values must be contiguous from zero.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "AdmissionRuleSourceKind": {
      "type": "string",
      "enum": [
        "git_ignore",
        "kin_ignore"
      ]
    },
    "AuthorId": {
      "description": "Author identifier (human or assistant).",
      "type": "string"
    },
    "Hash256": {
      "description": "Content-addressed 256-bit hash.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "RepoPath": {
      "type": "object",
      "required": [
        "bytes_hex"
      ],
      "properties": {
        "bytes_hex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SensitiveArtifactAllowance": {
      "description": "Explicit approval for exactly one sensitive path, digest, and entry kind.",
      "type": "object",
      "required": [
        "approved_by",
        "content_hash",
        "kind",
        "path",
        "reason"
      ],
      "properties": {
        "approved_by": {
          "$ref": "#/definitions/AuthorId"
        },
        "content_hash": {
          "$ref": "#/definitions/Hash256"
        },
        "kind": {
          "$ref": "#/definitions/SensitiveArtifactKind"
        },
        "path": {
          "$ref": "#/definitions/RepoPath"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SensitiveArtifactKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "executable",
            "type"
          ],
          "properties": {
            "executable": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "blob"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "symlink"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}