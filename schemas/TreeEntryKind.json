{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TreeEntryKind",
  "description": "Exact Git-relevant kind of a repository tree entry.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "executable",
        "type"
      ],
      "properties": {
        "executable": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "regular"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "symlink"
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}