{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitObjectId",
  "description": "Exact Git object identity stored by a gitlink tree entry.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "algorithm",
        "bytes"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha1"
          ]
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "maxItems": 20,
          "minItems": 20
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "algorithm",
        "bytes"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "maxItems": 32,
          "minItems": 32
        }
      },
      "additionalProperties": false
    }
  ]
}