{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SemanticChange",
  "description": "Kin's native commit, the unit of semantic history.\n\nPersisted positionally in every snapshot that carries history, so the crate-level positional-wire rule applies: a new field goes last, and only a trailing field may skip serialization.",
  "type": "object",
  "required": [
    "author",
    "entity_deltas",
    "evidence",
    "id",
    "message",
    "origin",
    "parents",
    "projected_files",
    "relation_deltas",
    "timestamp",
    "tree_deltas"
  ],
  "properties": {
    "admission_policy_delta": {
      "description": "History-versioned admission policy transition, when the policy changes.",
      "anyOf": [
        {
          "$ref": "#/definitions/AdmissionPolicyDelta"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "description": "Human or assistant.",
      "allOf": [
        {
          "$ref": "#/definitions/AuthorId"
        }
      ]
    },
    "entity_deltas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EntityDelta"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceId"
      }
    },
    "external_reference_deltas": {
      "description": "Exact transitions of first-class external-symbol endpoints.\n\nDeliberately last: persisted positional encodings treat an appended, omitted-empty field as additive, while inserting one earlier would reassign every field after it.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExternalReferenceDelta"
      }
    },
    "id": {
      "description": "Content-addressed hash.",
      "allOf": [
        {
          "$ref": "#/definitions/SemanticChangeId"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "origin": {
      "description": "Native provenance or the exact external commit identity imported.",
      "allOf": [
        {
          "$ref": "#/definitions/ChangeOrigin"
        }
      ]
    },
    "parents": {
      "description": "Ordered parent list: empty for genesis, one for an ordinary change, and any number for a merge. Order and repeated parent entries are preserved exactly for lossless Git commit import.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/SemanticChangeId"
      }
    },
    "projected_files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FilePathId"
      }
    },
    "relation_deltas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RelationDelta"
      }
    },
    "risk_summary": {
      "anyOf": [
        {
          "$ref": "#/definitions/RiskSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "spec_link": {
      "anyOf": [
        {
          "$ref": "#/definitions/SpecId"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "$ref": "#/definitions/Timestamp"
    },
    "tree_deltas": {
      "description": "Exact changes to the repository tree, including code, configuration, documentation, assets, and files in unsupported languages.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/TreeDelta"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AdmissionPolicyDelta": {
      "description": "Exact, self-inverting shared-policy transition.",
      "type": "object",
      "properties": {
        "new": {
          "anyOf": [
            {
              "$ref": "#/definitions/SharedAdmissionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "old": {
          "anyOf": [
            {
              "$ref": "#/definitions/SharedAdmissionPolicy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "AdmissionPolicyHash": {
      "description": "Content identity of a resolved shared admission policy.",
      "allOf": [
        {
          "$ref": "#/definitions/Hash256"
        }
      ]
    },
    "AdmissionRuleSource": {
      "description": "One branch-versioned gitwildmatch source.",
      "type": "object",
      "required": [
        "body_hash",
        "body_len",
        "kind",
        "path",
        "precedence"
      ],
      "properties": {
        "base_directory": {
          "description": "Directory against which patterns in this source are rooted. `None` denotes the repository root.",
          "anyOf": [
            {
              "$ref": "#/definitions/RepoPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_hash": {
          "$ref": "#/definitions/Hash256"
        },
        "body_len": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "$ref": "#/definitions/AdmissionRuleSourceKind"
        },
        "path": {
          "$ref": "#/definitions/RepoPath"
        },
        "precedence": {
          "description": "Low-to-high precedence. Values must be contiguous from zero.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "AdmissionRuleSourceKind": {
      "type": "string",
      "enum": [
        "git_ignore",
        "kin_ignore"
      ]
    },
    "ArtifactId": {
      "description": "Stable graph-assigned identity for a retrievable non-entity artifact.\n\nA path is a mutable location, not an identity seed. Importers allocate an ID once and persist the path-to-ID association in graph state.",
      "type": "string",
      "format": "uuid"
    },
    "AuthorId": {
      "description": "Author identifier (human or assistant).",
      "type": "string"
    },
    "CallArgShape": {
      "description": "The argument shape observed at a single call site: how many positional arguments were passed, which keyword-argument names were used, and whether the call forwards a `*args` positional splat or a `**kwargs` keyword splat.\n\nCaptured per `Calls` edge so a consumer that invokes a callable positionally (unaffected by a parameter rename) can be told apart from one that names a parameter (which a rename would strand). A `**kwargs` splat means the keyword set is not statically known; the arity is known exactly only when neither splat flag is set.\n\n`keywords` is kept sorted and deduplicated so the shape is order- and duplicate-independent, keeping graph writes deterministic.",
      "type": "object",
      "required": [
        "has_var_keyword",
        "has_var_positional",
        "keywords",
        "positional"
      ],
      "properties": {
        "has_var_keyword": {
          "description": "The call forwards a `**mapping` keyword splat, so its keyword set is not statically known.",
          "type": "boolean"
        },
        "has_var_positional": {
          "description": "The call forwards a `*sequence` positional splat (or an equivalent pack-expansion).",
          "type": "boolean"
        },
        "keywords": {
          "description": "Sorted, deduplicated names of explicit keyword arguments (`name=value`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "positional": {
          "description": "Number of positional argument expressions passed. A `*sequence` splat is not counted here; it is recorded by `has_var_positional`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ChangeOrigin": {
      "description": "Immutable provenance that participates in semantic-change identity.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "native"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "oid",
            "type"
          ],
          "properties": {
            "oid": {
              "$ref": "#/definitions/GitObjectId"
            },
            "type": {
              "type": "string",
              "enum": [
                "git_commit"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ContractId": {
      "description": "Unique identifier for a Contract.",
      "type": "string",
      "format": "uuid"
    },
    "Entity": {
      "description": "The atomic semantic unit in Kin's graph.",
      "type": "object",
      "required": [
        "fingerprint",
        "id",
        "kind",
        "language",
        "metadata",
        "name",
        "role",
        "signature",
        "visibility"
      ],
      "properties": {
        "created_in": {
          "description": "None while in overlay; set on kin commit.",
          "anyOf": [
            {
              "$ref": "#/definitions/SemanticChangeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "doc_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_origin": {
          "description": "None for graph-created entities before placement.",
          "anyOf": [
            {
              "$ref": "#/definitions/FilePathId"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "$ref": "#/definitions/SemanticFingerprint"
        },
        "id": {
          "$ref": "#/definitions/EntityId"
        },
        "kind": {
          "$ref": "#/definitions/EntityKind"
        },
        "language": {
          "$ref": "#/definitions/LanguageId"
        },
        "lineage_parent": {
          "anyOf": [
            {
              "$ref": "#/definitions/EntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/definitions/EntityMetadata"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/EntityRole"
        },
        "signature": {
          "type": "string"
        },
        "span": {
          "description": "None until projection assigns a file location.",
          "anyOf": [
            {
              "$ref": "#/definitions/SourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "superseded_by": {
          "anyOf": [
            {
              "$ref": "#/definitions/EntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "$ref": "#/definitions/Visibility"
        }
      }
    },
    "EntityDelta": {
      "description": "Delta for a single entity within a SemanticChange.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "new",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/Entity"
            },
            "operation": {
              "type": "string",
              "enum": [
                "added"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "new",
            "old",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/Entity"
            },
            "old": {
              "$ref": "#/definitions/Entity"
            },
            "operation": {
              "type": "string",
              "enum": [
                "modified"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "old",
            "operation"
          ],
          "properties": {
            "old": {
              "$ref": "#/definitions/Entity"
            },
            "operation": {
              "type": "string",
              "enum": [
                "removed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "EntityId": {
      "description": "Unique identifier for an Entity.",
      "type": "string",
      "format": "uuid"
    },
    "EntityKind": {
      "description": "Classification of a semantic entity.",
      "type": "string",
      "enum": [
        "function",
        "class",
        "interface",
        "trait_def",
        "type_alias",
        "module",
        "package",
        "test",
        "schema",
        "api_endpoint",
        "event_contract",
        "file",
        "document_node",
        "method",
        "enum_def",
        "enum_variant",
        "constant",
        "static_var",
        "macro"
      ]
    },
    "EntityMetadata": {
      "description": "Extensible metadata bag for entities.",
      "type": "object",
      "additionalProperties": true
    },
    "EntityRole": {
      "description": "Role of a semantic entity within the project.",
      "type": "string",
      "enum": [
        "source",
        "test",
        "external",
        "docs",
        "generated",
        "vendored"
      ]
    },
    "EvidenceId": {
      "description": "Unique identifier for an Evidence record.",
      "type": "string",
      "format": "uuid"
    },
    "ExternalReference": {
      "description": "Immutable, resolved endpoint for a symbol owned outside the local graph.\n\n`resolution_namespace` identifies both the resolver and its normalization contract. It is versioned so a change to that contract cannot silently reinterpret existing coordinates. `canonical_source` and `symbol` are resolver-issued opaque selectors, preserved byte-for-byte after validation.",
      "type": "object",
      "required": [
        "canonical_source",
        "hash",
        "id",
        "resolution_namespace",
        "schema_version",
        "symbol"
      ],
      "properties": {
        "canonical_source": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/definitions/Hash256"
        },
        "id": {
          "$ref": "#/definitions/ExternalReferenceId"
        },
        "resolution_namespace": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "symbol": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExternalReferenceDelta": {
      "description": "Exact, self-inverting transitions of persisted external endpoints.\n\nExternal references are immutable. A resolver coordinate change is an explicit removal plus addition (with any affected relation modified in the same transaction), never an in-place modification.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "new",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/ExternalReference"
            },
            "operation": {
              "type": "string",
              "enum": [
                "added"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "old",
            "operation"
          ],
          "properties": {
            "old": {
              "$ref": "#/definitions/ExternalReference"
            },
            "operation": {
              "type": "string",
              "enum": [
                "removed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ExternalReferenceId": {
      "description": "Stable identity of one resolver-issued external symbol coordinate.",
      "type": "string",
      "format": "uuid"
    },
    "FilePathId": {
      "description": "File path identifier.",
      "type": "string"
    },
    "FingerprintAlgorithm": {
      "type": "string",
      "enum": [
        "V1TreeSitter"
      ]
    },
    "GitObjectId": {
      "description": "Exact Git object identity stored by a gitlink tree entry.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "bytes"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha1"
              ]
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0.0
              },
              "maxItems": 20,
              "minItems": 20
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "bytes"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0.0
              },
              "maxItems": 32,
              "minItems": 32
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "GraphNodeId": {
      "description": "Typed graph node reference for first-class mixed-domain relations.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Entity"
          ],
          "properties": {
            "Entity": {
              "$ref": "#/definitions/EntityId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Artifact"
          ],
          "properties": {
            "Artifact": {
              "$ref": "#/definitions/ArtifactId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Test"
          ],
          "properties": {
            "Test": {
              "$ref": "#/definitions/TestId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Contract"
          ],
          "properties": {
            "Contract": {
              "$ref": "#/definitions/ContractId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Work"
          ],
          "properties": {
            "Work": {
              "$ref": "#/definitions/WorkId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "VerificationRun"
          ],
          "properties": {
            "VerificationRun": {
              "$ref": "#/definitions/VerificationRunId"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Symbol owned outside the local repository. Deliberately last so the public variant order remains append-only even though the current MessagePack encoder tags variants by name.",
          "type": "object",
          "required": [
            "ExternalReference"
          ],
          "properties": {
            "ExternalReference": {
              "$ref": "#/definitions/ExternalReferenceId"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Hash256": {
      "description": "Content-addressed 256-bit hash.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "LanguageId": {
      "description": "Supported programming languages (Tier 1).",
      "type": "string",
      "enum": [
        "TypeScript",
        "JavaScript",
        "Python",
        "Go",
        "Java",
        "Rust",
        "C",
        "Cpp",
        "CSharp",
        "Ruby",
        "Php",
        "Swift",
        "Kotlin",
        "Hcl"
      ]
    },
    "LocatedEntry": {
      "description": "One artifact's exact location and materialization at a repository ref.",
      "type": "object",
      "required": [
        "entry",
        "path"
      ],
      "properties": {
        "entry": {
          "$ref": "#/definitions/TreeEntry"
        },
        "path": {
          "$ref": "#/definitions/RepoPath"
        }
      },
      "additionalProperties": false
    },
    "Relation": {
      "description": "A typed edge in the semantic graph.",
      "type": "object",
      "required": [
        "confidence",
        "dst",
        "evidence",
        "id",
        "kind",
        "origin",
        "src"
      ],
      "properties": {
        "confidence": {
          "description": "Confidence score (0.0 - 1.0).",
          "type": "number",
          "format": "float"
        },
        "created_in": {
          "description": "None while in overlay; set on kin commit.",
          "anyOf": [
            {
              "$ref": "#/definitions/SemanticChangeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "dst": {
          "$ref": "#/definitions/GraphNodeId"
        },
        "evidence": {
          "description": "Parser/linker evidence for this edge.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RelationEvidence"
          }
        },
        "id": {
          "$ref": "#/definitions/RelationId"
        },
        "import_source": {
          "description": "For Calls/References edges, the module/package the target was imported from. Enables qualified cross-repo resolution in the spine. e.g., \"requests\" for `from requests import get`, \"kin_db\" for `use kin_db::InMemoryGraph`",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/RelationKind"
        },
        "origin": {
          "$ref": "#/definitions/RelationOrigin"
        },
        "src": {
          "$ref": "#/definitions/GraphNodeId"
        }
      }
    },
    "RelationDelta": {
      "description": "Delta for a single relation within a SemanticChange.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "new",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/Relation"
            },
            "operation": {
              "type": "string",
              "enum": [
                "added"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "new",
            "old",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/Relation"
            },
            "old": {
              "$ref": "#/definitions/Relation"
            },
            "operation": {
              "type": "string",
              "enum": [
                "modified"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "old",
            "operation"
          ],
          "properties": {
            "old": {
              "$ref": "#/definitions/Relation"
            },
            "operation": {
              "type": "string",
              "enum": [
                "removed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RelationEvidence": {
      "description": "Concrete evidence supporting a graph relation.",
      "type": "object",
      "required": [
        "occurrence_count"
      ],
      "properties": {
        "call_shape": {
          "description": "Argument shape of the call site that produced this edge, when captured. Present only for `Calls` edges from languages that emit shapes; non-call edges and unresolved calls leave it `None`.",
          "anyOf": [
            {
              "$ref": "#/definitions/CallArgShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurrence_count": {
          "description": "Number of equivalent occurrences collapsed into this evidence record.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "parser_rule": {
          "description": "Parser or linker rule that produced this evidence.",
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_path": {
          "description": "Resolved graph-owned target path, when the linker could resolve it.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "description": "Module/include path as written in source.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_span": {
          "description": "Source span of the syntax that produced the edge, when available.",
          "anyOf": [
            {
              "$ref": "#/definitions/SourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "description": "Lexical token at the evidence site, e.g. a macro name or imported symbol.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RelationId": {
      "description": "Unique identifier for a Relation.",
      "type": "string",
      "format": "uuid"
    },
    "RelationKind": {
      "description": "Classification of a relation edge.",
      "type": "string",
      "enum": [
        "Contains",
        "Extends",
        "Implements",
        "Overrides",
        "Calls",
        "Instantiates",
        "References",
        "UsesMacro",
        "UsesType",
        "Imports",
        "Includes",
        "DependsOn",
        "EmitsEvent",
        "SubscribesTo",
        "DefinesContract",
        "ConsumesContract",
        "SendsMessage",
        "Spawns",
        "Tests",
        "Covers",
        "CoChanges",
        "DerivedFrom",
        "DocumentedBy",
        "OwnedBy",
        "OwnedByFile"
      ]
    },
    "RelationOrigin": {
      "description": "How a relation was established.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Parsed",
            "Inferred",
            "Manual"
          ]
        },
        {
          "description": "Discovered via Language Server Protocol (type-resolved).",
          "type": "string",
          "enum": [
            "Lsp"
          ]
        }
      ]
    },
    "RepoPath": {
      "type": "object",
      "required": [
        "bytes_hex"
      ],
      "properties": {
        "bytes_hex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RiskLevel": {
      "description": "Risk classification.",
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "RiskSummary": {
      "description": "Summary of risk associated with a semantic change.",
      "type": "object",
      "required": [
        "breaking_changes",
        "contract_violations",
        "notes",
        "overall_risk",
        "test_coverage_gaps",
        "work_risks"
      ],
      "properties": {
        "breaking_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contract_violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overall_risk": {
          "$ref": "#/definitions/RiskLevel"
        },
        "test_coverage_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "work_risks": {
          "description": "Risks related to in-progress work items affected by changes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SemanticChangeId": {
      "description": "Content-addressed identifier for a SemanticChange.",
      "allOf": [
        {
          "$ref": "#/definitions/Hash256"
        }
      ]
    },
    "SemanticFingerprint": {
      "description": "Content-based fingerprint of an entity, used to detect what changed between revisions (structure, signature, and exact contents).",
      "type": "object",
      "required": [
        "algorithm",
        "ast_hash",
        "behavior_hash",
        "equivalence_hash",
        "signature_hash",
        "stability_score"
      ],
      "properties": {
        "algorithm": {
          "$ref": "#/definitions/FingerprintAlgorithm"
        },
        "ast_hash": {
          "description": "Hash of the normalized AST/source structure (insensitive to comments and whitespace).",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "behavior_hash": {
          "description": "Hash of the entity's full source text (changes on any body edit).",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "equivalence_hash": {
          "description": "Hash of the entity's behavior-equivalence class: the token stream with pure-no-op statements (e.g. docstrings) normalized away, so a behavior-preserving body edit leaves it unchanged while any real change alters it. The zero hash means \"not computed\" and is never treated as a match. Always serialized and required.",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "signature_hash": {
          "description": "Hash of the entity's signature line / declaration shape.",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "stability_score": {
          "description": "Confidence in fingerprint stability (0.0 - 1.0).",
          "type": "number",
          "format": "float"
        }
      }
    },
    "SensitiveArtifactAllowance": {
      "description": "Explicit approval for exactly one sensitive path, digest, and entry kind.",
      "type": "object",
      "required": [
        "approved_by",
        "content_hash",
        "kind",
        "path",
        "reason"
      ],
      "properties": {
        "approved_by": {
          "$ref": "#/definitions/AuthorId"
        },
        "content_hash": {
          "$ref": "#/definitions/Hash256"
        },
        "kind": {
          "$ref": "#/definitions/SensitiveArtifactKind"
        },
        "path": {
          "$ref": "#/definitions/RepoPath"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SensitiveArtifactKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "executable",
            "type"
          ],
          "properties": {
            "executable": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "blob"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "symlink"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SharedAdmissionPolicy": {
      "description": "Replicated admission policy resolved at a semantic change.",
      "type": "object",
      "required": [
        "generation",
        "hash",
        "semantics_version",
        "sensitive_allowances",
        "sources"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "hash": {
          "$ref": "#/definitions/AdmissionPolicyHash"
        },
        "semantics_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "sensitive_allowances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SensitiveArtifactAllowance"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AdmissionRuleSource"
          }
        }
      },
      "additionalProperties": false
    },
    "SourceSpan": {
      "description": "Source location of an entity within a file.",
      "type": "object",
      "required": [
        "end_byte",
        "end_col",
        "end_line",
        "file",
        "start_byte",
        "start_col",
        "start_line"
      ],
      "properties": {
        "end_byte": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "end_col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "file": {
          "$ref": "#/definitions/FilePathId"
        },
        "start_byte": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "start_col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "start_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "SpecId": {
      "description": "Unique identifier for a Spec.",
      "type": "string",
      "format": "uuid"
    },
    "TestId": {
      "description": "Unique identifier for a test case.",
      "allOf": [
        {
          "$ref": "#/definitions/Hash256"
        }
      ]
    },
    "Timestamp": {
      "description": "UTC timestamp wrapper.",
      "type": "string",
      "format": "date-time"
    },
    "TreeDelta": {
      "description": "Exact transition for one stable artifact identity in the repository tree.\n\n`Updated` covers content edits, mode changes, moves, and move-plus-edit. Paths are locations only; identity is always carried by `artifact_id`.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "artifact_id",
            "new",
            "operation"
          ],
          "properties": {
            "artifact_id": {
              "$ref": "#/definitions/ArtifactId"
            },
            "new": {
              "$ref": "#/definitions/LocatedEntry"
            },
            "operation": {
              "type": "string",
              "enum": [
                "added"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "artifact_id",
            "new",
            "old",
            "operation"
          ],
          "properties": {
            "artifact_id": {
              "$ref": "#/definitions/ArtifactId"
            },
            "new": {
              "$ref": "#/definitions/LocatedEntry"
            },
            "old": {
              "$ref": "#/definitions/LocatedEntry"
            },
            "operation": {
              "type": "string",
              "enum": [
                "updated"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "artifact_id",
            "old",
            "operation"
          ],
          "properties": {
            "artifact_id": {
              "$ref": "#/definitions/ArtifactId"
            },
            "old": {
              "$ref": "#/definitions/LocatedEntry"
            },
            "operation": {
              "type": "string",
              "enum": [
                "removed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "TreeEntry": {
      "description": "Exact materialization of one leaf in the repository tree.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "executable",
            "hash",
            "type"
          ],
          "properties": {
            "executable": {
              "type": "boolean"
            },
            "hash": {
              "$ref": "#/definitions/Hash256"
            },
            "type": {
              "type": "string",
              "enum": [
                "blob"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "The referenced blob contains the byte-exact link target.",
          "type": "object",
          "required": [
            "target_blob",
            "type"
          ],
          "properties": {
            "target_blob": {
              "$ref": "#/definitions/Hash256"
            },
            "type": {
              "type": "string",
              "enum": [
                "symlink"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A Git submodule pointer. The target need not exist in this repository's object database.",
          "type": "object",
          "required": [
            "target",
            "type"
          ],
          "properties": {
            "target": {
              "$ref": "#/definitions/GitObjectId"
            },
            "type": {
              "type": "string",
              "enum": [
                "gitlink"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "VerificationRunId": {
      "description": "Unique identifier for a verification run.",
      "allOf": [
        {
