{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TreeDelta",
  "description": "Exact transition for one stable artifact identity in the repository tree.\n\n`Updated` covers content edits, mode changes, moves, and move-plus-edit. Paths are locations only; identity is always carried by `artifact_id`.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "artifact_id",
        "new",
        "operation"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/definitions/ArtifactId"
        },
        "new": {
          "$ref": "#/definitions/LocatedEntry"
        },
        "operation": {
          "type": "string",
          "enum": [
            "added"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "artifact_id",
        "new",
        "old",
        "operation"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/definitions/ArtifactId"
        },
        "new": {
          "$ref": "#/definitions/LocatedEntry"
        },
        "old": {
          "$ref": "#/definitions/LocatedEntry"
        },
        "operation": {
          "type": "string",
          "enum": [
            "updated"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "artifact_id",
        "old",
        "operation"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/definitions/ArtifactId"
        },
        "old": {
          "$ref": "#/definitions/LocatedEntry"
        },
        "operation": {
          "type": "string",
          "enum": [
            "removed"
          ]
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "ArtifactId": {
      "description": "Stable graph-assigned identity for a retrievable non-entity artifact.\n\nA path is a mutable location, not an identity seed. Importers allocate an ID once and persist the path-to-ID association in graph state.",
      "type": "string",
      "format": "uuid"
    },
    "GitObjectId": {
      "description": "Exact Git object identity stored by a gitlink tree entry.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "bytes"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha1"
              ]
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0.0
              },
              "maxItems": 20,
              "minItems": 20
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "bytes"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0.0
              },
              "maxItems": 32,
              "minItems": 32
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Hash256": {
      "description": "Content-addressed 256-bit hash.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "LocatedEntry": {
      "description": "One artifact's exact location and materialization at a repository ref.",
      "type": "object",
      "required": [
        "entry",
        "path"
      ],
      "properties": {
        "entry": {
          "$ref": "#/definitions/TreeEntry"
        },
        "path": {
          "$ref": "#/definitions/RepoPath"
        }
      },
      "additionalProperties": false
    },
    "RepoPath": {
      "type": "object",
      "required": [
        "bytes_hex"
      ],
      "properties": {
        "bytes_hex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TreeEntry": {
      "description": "Exact materialization of one leaf in the repository tree.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "executable",
            "hash",
            "type"
          ],
          "properties": {
            "executable": {
              "type": "boolean"
            },
            "hash": {
              "$ref": "#/definitions/Hash256"
            },
            "type": {
              "type": "string",
              "enum": [
                "blob"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "The referenced blob contains the byte-exact link target.",
          "type": "object",
          "required": [
            "target_blob",
            "type"
          ],
          "properties": {
            "target_blob": {
              "$ref": "#/definitions/Hash256"
            },
            "type": {
              "type": "string",
              "enum": [
                "symlink"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A Git submodule pointer. The target need not exist in this repository's object database.",
          "type": "object",
          "required": [
            "target",
            "type"
          ],
          "properties": {
            "target": {
              "$ref": "#/definitions/GitObjectId"
            },
            "type": {
              "type": "string",
              "enum": [
                "gitlink"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}