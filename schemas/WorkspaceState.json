    "SemanticFingerprint": {
      "description": "Content-based fingerprint of an entity, used to detect what changed between revisions (structure, signature, and exact contents).",
      "type": "object",
      "required": [
        "algorithm",
        "ast_hash",
        "behavior_hash",
        "equivalence_hash",
        "signature_hash",
        "stability_score"
      ],
      "properties": {
        "algorithm": {
          "$ref": "#/definitions/FingerprintAlgorithm"
        },
        "ast_hash": {
          "description": "Hash of the normalized AST/source structure (insensitive to comments and whitespace).",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "behavior_hash": {
          "description": "Hash of the entity's full source text (changes on any body edit).",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "equivalence_hash": {
          "description": "Hash of the entity's behavior-equivalence class: the token stream with pure-no-op statements (e.g. docstrings) normalized away, so a behavior-preserving body edit leaves it unchanged while any real change alters it. The zero hash means \"not computed\" and is never treated as a match. Always serialized and required.",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "signature_hash": {
          "description": "Hash of the entity's signature line / declaration shape.",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "stability_score": {
          "description": "Confidence in fingerprint stability (0.0 - 1.0).",
          "type": "number",
          "format": "float"
        }
      }
    },
    "SensitiveArtifactAllowance": {
      "description": "Explicit approval for exactly one sensitive path, digest, and entry kind.",
