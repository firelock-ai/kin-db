{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkspaceState",
  "description": "Graph-owned exact working state for one local workspace or agent session.\n\nThis state is not derived from a branch on demand. The full repository tree is persisted independently so unsupported languages, configuration, binary assets, symlinks, gitlinks, and dirty changes all remain authoritative.",
  "type": "object",
  "required": [
    "admission_policy",
    "generation",
    "head",
    "repository_id",
    "semantic_overlay",
    "semantic_overlay_hash",
    "shared_admission_policy",
    "tree",
    "tree_hash",
    "workspace_id"
  ],
  "properties": {
    "admission_policy": {
      "$ref": "#/definitions/EffectiveAdmissionPolicyStamp"
    },
    "base_target": {
      "description": "Resolved target of `head`, or `None` for an unborn symbolic ref.",
      "anyOf": [
        {
          "$ref": "#/definitions/RefTarget"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_tree_hash": {
      "description": "Tree at `base_target`, or `None` for an unborn symbolic ref.",
      "anyOf": [
        {
          "$ref": "#/definitions/Hash256"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "head": {
      "$ref": "#/definitions/WorkspaceHead"
    },
    "repository_id": {
      "$ref": "#/definitions/RepositoryId"
    },
    "semantic_overlay": {
      "description": "Complete uncommitted semantic state relative to `base_target`.",
      "allOf": [
        {
          "$ref": "#/definitions/WorkspaceSemanticDelta"
        }
      ]
    },
    "semantic_overlay_hash": {
      "$ref": "#/definitions/Hash256"
    },
    "shared_admission_policy": {
      "description": "Complete shared matcher policy active for this exact workspace tree.\n\nThis may be newer than committed history when a dirty workspace edits `.gitignore` or `.kinignore`.",
      "allOf": [
        {
          "$ref": "#/definitions/SharedAdmissionPolicy"
        }
      ]
    },
    "tree": {
      "description": "Exact graph-owned working tree, including uncommitted state.",
      "allOf": [
        {
          "$ref": "#/definitions/ResolvedTree"
        }
      ]
    },
    "tree_hash": {
      "$ref": "#/definitions/Hash256"
    },
    "workspace_id": {
      "$ref": "#/definitions/WorkspaceId"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AdmissionPolicyHash": {
      "description": "Content identity of a resolved shared admission policy.",
      "allOf": [
        {
          "$ref": "#/definitions/Hash256"
        }
      ]
    },
    "AdmissionPolicyStamp": {
      "type": "object",
      "required": [
        "generation",
        "hash"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "hash": {
          "$ref": "#/definitions/AdmissionPolicyHash"
        }
      },
      "additionalProperties": false
    },
    "AdmissionRuleSource": {
      "description": "One branch-versioned gitwildmatch source.",
      "type": "object",
      "required": [
        "body_hash",
        "body_len",
        "kind",
        "path",
        "precedence"
      ],
      "properties": {
        "base_directory": {
          "description": "Directory against which patterns in this source are rooted. `None` denotes the repository root.",
          "anyOf": [
            {
              "$ref": "#/definitions/RepoPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_hash": {
          "$ref": "#/definitions/Hash256"
        },
        "body_len": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "$ref": "#/definitions/AdmissionRuleSourceKind"
        },
        "path": {
          "$ref": "#/definitions/RepoPath"
        },
        "precedence": {
          "description": "Low-to-high precedence. Values must be contiguous from zero.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "AdmissionRuleSourceKind": {
      "type": "string",
      "enum": [
        "git_ignore",
        "kin_ignore"
      ]
    },
    "ArtifactId": {
      "description": "Stable graph-assigned identity for a retrievable non-entity artifact.\n\nA path is a mutable location, not an identity seed. Importers allocate an ID once and persist the path-to-ID association in graph state.",
      "type": "string",
      "format": "uuid"
    },
    "AuthorId": {
      "description": "Author identifier (human or assistant).",
      "type": "string"
    },
    "CallArgShape": {
      "description": "The argument shape observed at a single call site: how many positional arguments were passed, which keyword-argument names were used, and whether the call forwards a `*args` positional splat or a `**kwargs` keyword splat.\n\nCaptured per `Calls` edge so a consumer that invokes a callable positionally (unaffected by a parameter rename) can be told apart from one that names a parameter (which a rename would strand). A `**kwargs` splat means the keyword set is not statically known; the arity is known exactly only when neither splat flag is set.\n\n`keywords` is kept sorted and deduplicated so the shape is order- and duplicate-independent, keeping graph writes deterministic.",
      "type": "object",
      "required": [
        "has_var_keyword",
        "has_var_positional",
        "keywords",
        "positional"
      ],
      "properties": {
        "has_var_keyword": {
          "description": "The call forwards a `**mapping` keyword splat, so its keyword set is not statically known.",
          "type": "boolean"
        },
        "has_var_positional": {
          "description": "The call forwards a `*sequence` positional splat (or an equivalent pack-expansion).",
          "type": "boolean"
        },
        "keywords": {
          "description": "Sorted, deduplicated names of explicit keyword arguments (`name=value`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "positional": {
          "description": "Number of positional argument expressions passed. A `*sequence` splat is not counted here; it is recorded by `has_var_positional`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ContractId": {
      "description": "Unique identifier for a Contract.",
      "type": "string",
      "format": "uuid"
    },
    "EffectiveAdmissionPolicyStamp": {
      "description": "Complete policy identity consumed by one local workspace.",
      "type": "object",
      "required": [
        "local",
        "shared"
      ],
      "properties": {
        "local": {
          "$ref": "#/definitions/LocalOverlayStamp"
        },
        "shared": {
          "$ref": "#/definitions/AdmissionPolicyStamp"
        }
      },
      "additionalProperties": false
    },
    "Entity": {
      "description": "The atomic semantic unit in Kin's graph.",
      "type": "object",
      "required": [
        "fingerprint",
        "id",
        "kind",
        "language",
        "metadata",
        "name",
        "role",
        "signature",
        "visibility"
      ],
      "properties": {
        "created_in": {
          "description": "None while in overlay; set on kin commit.",
          "anyOf": [
            {
              "$ref": "#/definitions/SemanticChangeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "doc_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_origin": {
          "description": "None for graph-created entities before placement.",
          "anyOf": [
            {
              "$ref": "#/definitions/FilePathId"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "$ref": "#/definitions/SemanticFingerprint"
        },
        "id": {
          "$ref": "#/definitions/EntityId"
        },
        "kind": {
          "$ref": "#/definitions/EntityKind"
        },
        "language": {
          "$ref": "#/definitions/LanguageId"
        },
        "lineage_parent": {
          "anyOf": [
            {
              "$ref": "#/definitions/EntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/definitions/EntityMetadata"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/EntityRole"
        },
        "signature": {
          "type": "string"
        },
        "span": {
          "description": "None until projection assigns a file location.",
          "anyOf": [
            {
              "$ref": "#/definitions/SourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "superseded_by": {
          "anyOf": [
            {
              "$ref": "#/definitions/EntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "$ref": "#/definitions/Visibility"
        }
      }
    },
    "EntityDelta": {
      "description": "Delta for a single entity within a SemanticChange.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "new",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/Entity"
            },
            "operation": {
              "type": "string",
              "enum": [
                "added"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "new",
            "old",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/Entity"
            },
            "old": {
              "$ref": "#/definitions/Entity"
            },
            "operation": {
              "type": "string",
              "enum": [
                "modified"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "old",
            "operation"
          ],
          "properties": {
            "old": {
              "$ref": "#/definitions/Entity"
            },
            "operation": {
              "type": "string",
              "enum": [
                "removed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "EntityId": {
      "description": "Unique identifier for an Entity.",
      "type": "string",
      "format": "uuid"
    },
    "EntityKind": {
      "description": "Classification of a semantic entity.",
      "type": "string",
      "enum": [
        "function",
        "class",
        "interface",
        "trait_def",
        "type_alias",
        "module",
        "package",
        "test",
        "schema",
        "api_endpoint",
        "event_contract",
        "file",
        "document_node",
        "method",
        "enum_def",
        "enum_variant",
        "constant",
        "static_var",
        "macro"
      ]
    },
    "EntityMetadata": {
      "description": "Extensible metadata bag for entities.",
      "type": "object",
      "additionalProperties": true
    },
    "EntityRole": {
      "description": "Role of a semantic entity within the project.",
      "type": "string",
      "enum": [
        "source",
        "test",
        "external",
        "docs",
        "generated",
        "vendored"
      ]
    },
    "ExternalObjectId": {
      "description": "Typed identity of one object in an external Git object database.",
      "type": "object",
      "required": [
        "kind",
        "oid"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/ExternalObjectKind"
        },
        "oid": {
          "$ref": "#/definitions/GitObjectId"
        }
      },
      "additionalProperties": false
    },
    "ExternalObjectKind": {
      "description": "The object type that participates in Git's object header and object ID.",
      "type": "string",
      "enum": [
        "commit",
        "tree",
        "blob",
        "tag"
      ]
    },
    "ExternalReference": {
      "description": "Immutable, resolved endpoint for a symbol owned outside the local graph.\n\n`resolution_namespace` identifies both the resolver and its normalization contract. It is versioned so a change to that contract cannot silently reinterpret existing coordinates. `canonical_source` and `symbol` are resolver-issued opaque selectors, preserved byte-for-byte after validation.",
      "type": "object",
      "required": [
        "canonical_source",
        "hash",
        "id",
        "resolution_namespace",
        "schema_version",
        "symbol"
      ],
      "properties": {
        "canonical_source": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/definitions/Hash256"
        },
        "id": {
          "$ref": "#/definitions/ExternalReferenceId"
        },
        "resolution_namespace": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "symbol": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExternalReferenceDelta": {
      "description": "Exact, self-inverting transitions of persisted external endpoints.\n\nExternal references are immutable. A resolver coordinate change is an explicit removal plus addition (with any affected relation modified in the same transaction), never an in-place modification.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "new",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/ExternalReference"
            },
            "operation": {
              "type": "string",
              "enum": [
                "added"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "old",
            "operation"
          ],
          "properties": {
            "old": {
              "$ref": "#/definitions/ExternalReference"
            },
            "operation": {
              "type": "string",
              "enum": [
                "removed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ExternalReferenceId": {
      "description": "Stable identity of one resolver-issued external symbol coordinate.",
      "type": "string",
      "format": "uuid"
    },
    "FilePathId": {
      "description": "File path identifier.",
      "type": "string"
    },
    "FingerprintAlgorithm": {
      "type": "string",
      "enum": [
        "V1TreeSitter"
      ]
    },
    "GitObjectId": {
      "description": "Exact Git object identity stored by a gitlink tree entry.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "bytes"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha1"
              ]
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0.0
              },
              "maxItems": 20,
              "minItems": 20
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "bytes"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0.0
              },
              "maxItems": 32,
              "minItems": 32
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "GraphNodeId": {
      "description": "Typed graph node reference for first-class mixed-domain relations.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Entity"
          ],
          "properties": {
            "Entity": {
              "$ref": "#/definitions/EntityId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Artifact"
          ],
          "properties": {
            "Artifact": {
              "$ref": "#/definitions/ArtifactId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Test"
          ],
          "properties": {
            "Test": {
              "$ref": "#/definitions/TestId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Contract"
          ],
          "properties": {
            "Contract": {
              "$ref": "#/definitions/ContractId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Work"
          ],
          "properties": {
            "Work": {
              "$ref": "#/definitions/WorkId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "VerificationRun"
          ],
          "properties": {
            "VerificationRun": {
              "$ref": "#/definitions/VerificationRunId"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Symbol owned outside the local repository. Deliberately last so the public variant order remains append-only even though the current MessagePack encoder tags variants by name.",
          "type": "object",
          "required": [
            "ExternalReference"
          ],
          "properties": {
            "ExternalReference": {
              "$ref": "#/definitions/ExternalReferenceId"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Hash256": {
      "description": "Content-addressed 256-bit hash.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "LanguageId": {
      "description": "Supported programming languages (Tier 1).",
      "type": "string",
      "enum": [
        "TypeScript",
        "JavaScript",
        "Python",
        "Go",
        "Java",
        "Rust",
        "C",
        "Cpp",
        "CSharp",
        "Ruby",
        "Php",
        "Swift",
        "Kotlin",
        "Hcl"
      ]
    },
    "LocalOverlayHash": {
      "$ref": "#/definitions/Hash256"
    },
    "LocalOverlayStamp": {
      "type": "object",
      "required": [
        "generation",
        "hash"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "hash": {
          "$ref": "#/definitions/LocalOverlayHash"
        }
      },
      "additionalProperties": false
    },
    "RefName": {
      "type": "object",
      "required": [
        "bytes_hex"
      ],
      "properties": {
        "bytes_hex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RefTarget": {
      "description": "Exact target of a repository ref.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "change_id",
            "type"
          ],
          "properties": {
            "change_id": {
              "$ref": "#/definitions/SemanticChangeId"
            },
            "type": {
              "type": "string",
              "enum": [
                "change"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "object",
            "type"
          ],
          "properties": {
            "object": {
              "$ref": "#/definitions/ExternalObjectId"
            },
            "type": {
              "type": "string",
              "enum": [
                "external_object"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "target",
            "type"
          ],
          "properties": {
            "target": {
              "$ref": "#/definitions/RefName"
            },
            "type": {
              "type": "string",
              "enum": [
                "symbolic"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Relation": {
      "description": "A typed edge in the semantic graph.",
      "type": "object",
      "required": [
        "confidence",
        "dst",
        "evidence",
        "id",
        "kind",
        "origin",
        "src"
      ],
      "properties": {
        "confidence": {
          "description": "Confidence score (0.0 - 1.0).",
          "type": "number",
          "format": "float"
        },
        "created_in": {
          "description": "None while in overlay; set on kin commit.",
          "anyOf": [
            {
              "$ref": "#/definitions/SemanticChangeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "dst": {
          "$ref": "#/definitions/GraphNodeId"
        },
        "evidence": {
          "description": "Parser/linker evidence for this edge.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RelationEvidence"
          }
        },
        "id": {
          "$ref": "#/definitions/RelationId"
        },
        "import_source": {
          "description": "For Calls/References edges, the module/package the target was imported from. Enables qualified cross-repo resolution in the spine. e.g., \"requests\" for `from requests import get`, \"kin_db\" for `use kin_db::InMemoryGraph`",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/RelationKind"
        },
        "origin": {
          "$ref": "#/definitions/RelationOrigin"
        },
        "src": {
          "$ref": "#/definitions/GraphNodeId"
        }
      }
    },
    "RelationDelta": {
      "description": "Delta for a single relation within a SemanticChange.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "new",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/Relation"
            },
            "operation": {
              "type": "string",
              "enum": [
                "added"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "new",
            "old",
            "operation"
          ],
          "properties": {
            "new": {
              "$ref": "#/definitions/Relation"
            },
            "old": {
              "$ref": "#/definitions/Relation"
            },
            "operation": {
              "type": "string",
              "enum": [
                "modified"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "old",
            "operation"
          ],
          "properties": {
            "old": {
              "$ref": "#/definitions/Relation"
            },
            "operation": {
              "type": "string",
              "enum": [
                "removed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RelationEvidence": {
      "description": "Concrete evidence supporting a graph relation.",
      "type": "object",
      "required": [
        "occurrence_count"
      ],
      "properties": {
        "call_shape": {
          "description": "Argument shape of the call site that produced this edge, when captured. Present only for `Calls` edges from languages that emit shapes; non-call edges and unresolved calls leave it `None`.",
          "anyOf": [
            {
              "$ref": "#/definitions/CallArgShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurrence_count": {
          "description": "Number of equivalent occurrences collapsed into this evidence record.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "parser_rule": {
          "description": "Parser or linker rule that produced this evidence.",
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_path": {
          "description": "Resolved graph-owned target path, when the linker could resolve it.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "description": "Module/include path as written in source.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_span": {
          "description": "Source span of the syntax that produced the edge, when available.",
          "anyOf": [
            {
              "$ref": "#/definitions/SourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "description": "Lexical token at the evidence site, e.g. a macro name or imported symbol.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
