    "WorkspaceSemanticDelta": {
      "description": "One canonical entity/relation transition for mutable workspace authority.\n\n[`WorkspaceMutation::semantic_delta`] carries the incremental transition from the expected workspace graph to its successor. The same representation is stored cumulatively in [`WorkspaceState::semantic_overlay`] relative to `base_target`. Exact repository membership remains independently authoritative in [`WorkspaceState::tree`].",
      "type": "object",
      "required": [
        "entity_deltas",
        "relation_deltas",
        "version"
      ],
      "properties": {
        "entity_deltas": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EntityDelta"
          }
        },
        "external_reference_deltas": {
          "description": "Deliberately last for additive positional-wire compatibility.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExternalReferenceDelta"
          }
        },
        "relation_deltas": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RelationDelta"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
