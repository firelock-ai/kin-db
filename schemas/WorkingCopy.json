{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkingCopy",
  "description": "The developer's in-progress state.",
  "type": "object",
  "required": [
    "base_change",
    "uncommitted_mutations"
  ],
  "properties": {
    "base_change": {
      "description": "Genesis change after kin init, advances on commit.",
      "allOf": [
        {
          "$ref": "#/definitions/SemanticChangeId"
        }
      ]
    },
    "uncommitted_mutations": {
      "description": "In-memory diff layer over the base graph.",
      "allOf": [
        {
          "$ref": "#/definitions/GraphOverlay"
        }
      ]
    }
  },
  "definitions": {
    "ArtifactId": {
      "description": "Deterministic ID for retrievable non-entity graph objects.\n\nArtifact IDs are derived from graph-owned file paths so the same tracked artifact produces the same retrieval ID across re-index and re-init.",
      "type": "string",
      "format": "uuid"
    },
    "CallArgShape": {
      "description": "The argument shape observed at a single call site: how many positional arguments were passed, which keyword-argument names were used, and whether the call forwards a `*args` positional splat or a `**kwargs` keyword splat.\n\nCaptured per `Calls` edge so a consumer that invokes a callable positionally (unaffected by a parameter rename) can be told apart from one that names a parameter (which a rename would strand). A `**kwargs` splat means the keyword set is not statically known; the arity is known exactly only when neither splat flag is set.\n\n`keywords` is kept sorted and deduplicated so the shape is order- and duplicate-independent, keeping graph writes deterministic.",
      "type": "object",
      "properties": {
        "has_var_keyword": {
          "description": "The call forwards a `**mapping` keyword splat, so its keyword set is not statically known.",
          "default": false,
          "type": "boolean"
        },
        "has_var_positional": {
          "description": "The call forwards a `*sequence` positional splat (or an equivalent pack-expansion).",
          "default": false,
          "type": "boolean"
        },
        "keywords": {
          "description": "Sorted, deduplicated names of explicit keyword arguments (`name=value`).",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "positional": {
          "description": "Number of positional argument expressions passed. A `*sequence` splat is not counted here; it is recorded by `has_var_positional`.",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ContractId": {
      "description": "Unique identifier for a Contract.",
      "type": "string",
      "format": "uuid"
    },
    "Entity": {
      "description": "The atomic semantic unit in Kin's graph.",
      "type": "object",
      "required": [
        "fingerprint",
        "id",
        "kind",
        "language",
        "metadata",
        "name",
        "signature",
        "visibility"
      ],
      "properties": {
        "created_in": {
          "description": "None while in overlay; set on kin commit.",
          "anyOf": [
            {
              "$ref": "#/definitions/SemanticChangeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "doc_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_origin": {
          "description": "None for graph-created entities before placement.",
          "anyOf": [
            {
              "$ref": "#/definitions/FilePathId"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "$ref": "#/definitions/SemanticFingerprint"
        },
        "id": {
          "$ref": "#/definitions/EntityId"
        },
        "kind": {
          "$ref": "#/definitions/EntityKind"
        },
        "language": {
          "$ref": "#/definitions/LanguageId"
        },
        "lineage_parent": {
          "anyOf": [
            {
              "$ref": "#/definitions/EntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/definitions/EntityMetadata"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "default": "source",
          "allOf": [
            {
              "$ref": "#/definitions/EntityRole"
            }
          ]
        },
        "signature": {
          "type": "string"
        },
        "span": {
          "description": "None until projection assigns a file location.",
          "anyOf": [
            {
              "$ref": "#/definitions/SourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "superseded_by": {
          "anyOf": [
            {
              "$ref": "#/definitions/EntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "$ref": "#/definitions/Visibility"
        }
      }
    },
    "EntityId": {
      "description": "Unique identifier for an Entity.",
      "type": "string",
      "format": "uuid"
    },
    "EntityKind": {
      "description": "Classification of a semantic entity.",
      "type": "string",
      "enum": [
        "function",
        "class",
        "interface",
        "trait_def",
        "type_alias",
        "module",
        "package",
        "test",
        "schema",
        "api_endpoint",
        "event_contract",
        "file",
        "document_node",
        "method",
        "enum_def",
        "enum_variant",
        "constant",
        "static_var",
        "macro"
      ]
    },
    "EntityMetadata": {
      "description": "Extensible metadata bag for entities.",
      "type": "object",
      "additionalProperties": true
    },
    "EntityRole": {
      "description": "Role of a semantic entity within the project.",
      "type": "string",
      "enum": [
        "source",
        "test",
        "external",
        "docs",
        "generated",
        "vendored"
      ]
    },
    "FilePathId": {
      "description": "File path identifier.",
      "type": "string"
    },
    "FingerprintAlgorithm": {
      "type": "string",
      "enum": [
        "V1TreeSitter"
      ]
    },
    "GraphNodeId": {
      "description": "Typed graph node reference for first-class mixed-domain relations.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Entity"
          ],
          "properties": {
            "Entity": {
              "$ref": "#/definitions/EntityId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Artifact"
          ],
          "properties": {
            "Artifact": {
              "$ref": "#/definitions/ArtifactId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Test"
          ],
          "properties": {
            "Test": {
              "$ref": "#/definitions/TestId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Contract"
          ],
          "properties": {
            "Contract": {
              "$ref": "#/definitions/ContractId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Work"
          ],
          "properties": {
            "Work": {
              "$ref": "#/definitions/WorkId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "VerificationRun"
          ],
          "properties": {
            "VerificationRun": {
              "$ref": "#/definitions/VerificationRunId"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "GraphOverlay": {
      "description": "In-memory diff applied on top of the current branch head.",
      "type": "object",
      "required": [
        "entity_adds",
        "entity_mods",
        "entity_removes",
        "relation_adds",
        "relation_removes",
        "tree_deltas"
      ],
      "properties": {
        "entity_adds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Entity"
          }
        },
        "entity_bodies": {
          "description": "Entity bodies for modified/added entities. Used by VFS to project overlay changes without re-reading files.",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0.0
            }
          }
        },
        "entity_mods": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Entity"
          }
        },
        "entity_removes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EntityId"
          }
        },
        "relation_adds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Relation"
          }
        },
        "relation_removes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RelationId"
          }
        },
        "tree_deltas": {
          "description": "Exact repository-tree transitions staged in this working copy.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/TreeDelta"
          }
        }
      }
    },
    "Hash256": {
      "description": "Content-addressed 256-bit hash.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "LanguageId": {
      "description": "Supported programming languages (Tier 1).",
      "type": "string",
      "enum": [
        "TypeScript",
        "JavaScript",
        "Python",
        "Go",
        "Java",
        "Rust",
        "C",
        "Cpp",
        "CSharp",
        "Ruby",
        "Php",
        "Swift",
        "Kotlin",
        "Hcl"
      ]
    },
    "Relation": {
      "description": "A typed edge in the semantic graph.",
      "type": "object",
      "required": [
        "confidence",
        "dst",
        "id",
        "kind",
        "origin",
        "src"
      ],
      "properties": {
        "confidence": {
          "description": "Confidence score (0.0 - 1.0).",
          "type": "number",
          "format": "float"
        },
        "created_in": {
          "description": "None while in overlay; set on kin commit.",
          "anyOf": [
            {
              "$ref": "#/definitions/SemanticChangeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "dst": {
          "$ref": "#/definitions/GraphNodeId"
        },
        "evidence": {
          "description": "Parser/linker evidence for this edge. Older snapshots do not carry this field, so it must remain defaultable.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/RelationEvidence"
          }
        },
        "id": {
          "$ref": "#/definitions/RelationId"
        },
        "import_source": {
          "description": "For Calls/References edges, the module/package the target was imported from. Enables qualified cross-repo resolution in the spine. e.g., \"requests\" for `from requests import get`, \"kin_db\" for `use kin_db::InMemoryGraph`",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/RelationKind"
        },
        "origin": {
          "$ref": "#/definitions/RelationOrigin"
        },
        "src": {
          "$ref": "#/definitions/GraphNodeId"
        }
      }
    },
    "RelationEvidence": {
      "description": "Concrete evidence supporting a graph relation.",
      "type": "object",
      "properties": {
        "call_shape": {
          "description": "Argument shape of the call site that produced this edge, when captured. Present only for `Calls` edges from languages that emit shapes; older snapshots, non-call edges, and unresolved calls leave it `None`.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/CallArgShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurrence_count": {
          "description": "Number of equivalent occurrences collapsed into this evidence record.",
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "parser_rule": {
          "description": "Parser or linker rule that produced this evidence.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_path": {
          "description": "Resolved graph-owned target path, when the linker could resolve it.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "description": "Module/include path as written in source.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "source_span": {
          "description": "Source span of the syntax that produced the edge, when available.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/SourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "description": "Lexical token at the evidence site, e.g. a macro name or imported symbol.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RelationId": {
      "description": "Unique identifier for a Relation.",
      "type": "string",
      "format": "uuid"
    },
    "RelationKind": {
      "description": "Classification of a relation edge.",
      "type": "string",
      "enum": [
        "Contains",
        "Extends",
        "Implements",
        "Overrides",
        "Calls",
        "Instantiates",
        "References",
        "UsesMacro",
        "UsesType",
        "Imports",
        "Includes",
        "DependsOn",
        "EmitsEvent",
        "SubscribesTo",
        "DefinesContract",
        "ConsumesContract",
        "SendsMessage",
        "Spawns",
        "Tests",
        "Covers",
        "CoChanges",
        "DerivedFrom",
        "DocumentedBy",
        "OwnedBy",
        "OwnedByFile"
      ]
    },
    "RelationOrigin": {
      "description": "How a relation was established.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Parsed",
            "Inferred",
            "Manual"
          ]
        },
        {
          "description": "Discovered via Language Server Protocol (type-resolved).",
          "type": "string",
          "enum": [
            "Lsp"
          ]
        }
      ]
    },
    "SemanticChangeId": {
      "description": "Content-addressed identifier for a SemanticChange.",
      "allOf": [
        {
          "$ref": "#/definitions/Hash256"
        }
      ]
    },
    "SemanticFingerprint": {
      "description": "Content-based fingerprint of an entity, used to detect what changed between revisions (structure, signature, and exact contents).",
      "type": "object",
      "required": [
        "algorithm",
        "ast_hash",
        "behavior_hash",
        "equivalence_hash",
        "signature_hash",
        "stability_score"
      ],
      "properties": {
        "algorithm": {
          "$ref": "#/definitions/FingerprintAlgorithm"
        },
        "ast_hash": {
          "description": "Hash of the normalized AST/source structure (insensitive to comments and whitespace).",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "behavior_hash": {
          "description": "Hash of the entity's full source text (changes on any body edit).",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "equivalence_hash": {
          "description": "Hash of the entity's behavior-equivalence class: the token stream with pure-no-op statements (e.g. docstrings) normalized away, so a behavior-preserving body edit leaves it unchanged while any real change alters it. The zero hash (the serde default) means \"not computed\" and is never treated as a match. Always serialized. The custom deserializer accepts both the legacy five-field sequence and the current six-field sequence because graph snapshots use a positional binary format.",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "signature_hash": {
          "description": "Hash of the entity's signature line / declaration shape.",
          "allOf": [
            {
              "$ref": "#/definitions/Hash256"
            }
          ]
        },
        "stability_score": {
          "description": "Confidence in fingerprint stability (0.0 - 1.0).",
          "type": "number",
          "format": "float"
        }
      }
    },
    "SourceSpan": {
      "description": "Source location of an entity within a file.",
      "type": "object",
      "required": [
        "end_byte",
        "end_col",
        "end_line",
        "file",
        "start_byte",
        "start_col",
        "start_line"
      ],
      "properties": {
        "end_byte": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "end_col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "file": {
          "$ref": "#/definitions/FilePathId"
        },
        "start_byte": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "start_col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "start_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "TestId": {
      "description": "Unique identifier for a test case.",
      "allOf": [
        {
          "$ref": "#/definitions/Hash256"
        }
      ]
    },
    "TreeDelta": {
      "description": "Exact transition for one path in the repository tree.\n\nEach variant carries every entry needed to describe the transition. This makes mode-unknown entries, missing hashes, and `None -> None` deltas unrepresentable.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "file_id",
            "new_entry",
            "operation"
          ],
          "properties": {
            "file_id": {
              "$ref": "#/definitions/FilePathId"
            },
            "new_entry": {
              "$ref": "#/definitions/TreeEntry"
            },
            "operation": {
              "type": "string",
              "enum": [
                "added"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "file_id",
            "new_entry",
            "old_entry",
            "operation"
          ],
          "properties": {
            "file_id": {
              "$ref": "#/definitions/FilePathId"
            },
            "new_entry": {
              "$ref": "#/definitions/TreeEntry"
            },
            "old_entry": {
              "$ref": "#/definitions/TreeEntry"
            },
            "operation": {
              "type": "string",
              "enum": [
                "modified"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "file_id",
            "old_entry",
            "operation"
          ],
          "properties": {
            "file_id": {
              "$ref": "#/definitions/FilePathId"
            },
            "old_entry": {
              "$ref": "#/definitions/TreeEntry"
            },
            "operation": {
              "type": "string",
              "enum": [
                "removed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "TreeEntry": {
      "description": "Content identity and exact mode for one repository tree entry.\n\nSymlink entries store the link target bytes as the referenced blob.",
      "type": "object",
      "required": [
        "blob_hash",
        "kind"
      ],
      "properties": {
        "blob_hash": {
          "$ref": "#/definitions/Hash256"
        },
        "kind": {
          "$ref": "#/definitions/TreeEntryKind"
        }
      },
      "additionalProperties": false
    },
    "TreeEntryKind": {
      "description": "Exact Git-relevant kind of a repository tree entry.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "executable",
            "type"
          ],
          "properties": {
            "executable": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "regular"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "symlink"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "VerificationRunId": {
      "description": "Unique identifier for a verification run.",
      "allOf": [
        {
          "$ref": "#/definitions/Hash256"
        }
      ]
    },
    "Visibility": {
      "description": "Visibility of a semantic entity.",
      "type": "string",
      "enum": [
        "Public",
        "Private",
        "Internal",
        "Crate"
      ]
    },
    "WorkId": {
      "description": "Unique identifier for a WorkItem.",
      "type": "string",
      "format": "uuid"
    }
  }
}